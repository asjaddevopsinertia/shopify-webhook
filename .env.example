SHOPIFY_CLIENT_SECRET=
SHOPIFY_CLIENT_ID=

SHOPIFY_SHOP_DOMAIN=tangerine-farm.myshopify.com

# Webhook Secret (still needed for webhook verification)
SHOPIFY_WEBHOOK_SECRET=

# Server Configuration
PORT=7000
NODE_ENV=production

MONGODB_URI=
MONGODB_DB=shopify
ORDERS_COLLECTION=orders
ORDERS_DB_NAME=shopify

JWT_SECRET=
JWT_EXPIRES_IN=30d
ADMIN_EMAIL=
ADMIN_PASSWORD=


#FRONTEND_URL=https://inventorymanagement.marmaladegrove.com

SHIPSTATION_API_KEY=
SHIPSTATION_API_SECRET=

# apa_e2yjtktkha
FAIRE_ACCESS_TOKEN=


FAIRE_APP_CREDENTIALS=
# Bounded order preparation workers (1-16); API rate limits still apply.
IMPORT_CONCURRENCY=4

# Live webhook worker settings (defaults shown; signing secret above must match
# the app or Shopify-admin webhook configuration that sends these deliveries).
WEBHOOK_WORKERS=2
WEBHOOK_PENDING_MINUTES=5
WEBHOOK_REFRESH_MINUTES=360
WEBHOOK_RECONCILE_MINUTES=5
WEBHOOK_RECONCILE_LOOKBACK_HOURS=24
WEBHOOK_SEED_PENDING_ORDERS=1
# HOST=127.0.0.1 for a local reverse proxy; HOST=0.0.0.0 for containers.
